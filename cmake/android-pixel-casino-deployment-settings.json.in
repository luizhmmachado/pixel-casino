{
  "description": "Generated by CMake for androiddeployqt.",
  "qt": "@QT_INSTALL_PREFIX@",
  "sdk": "$ENV{ANDROID_SDK_ROOT}",
  "ndk": "$ENV{ANDROID_NDK_ROOT}",
  "toolchain-prefix": "llvm",
  "tool-prefix": "llvm",
  "architectures": {"arm64-v8a":"aarch64-linux-android"},
  "android-min-sdk-version": "23",
  "android-target-sdk-version": "31",
  "qml-import-paths": "@CMAKE_CURRENT_SOURCE_DIR@/ui",
  "qml-root-path": "@CMAKE_CURRENT_SOURCE_DIR@",
  "qrcFiles": "@CMAKE_CURRENT_SOURCE_DIR@/qml.qrc,@CMAKE_CURRENT_SOURCE_DIR@/resources.qrc",
  "application-binary": "@CMAKE_CURRENT_BINARY_DIR@/libpixel-casino.so"
}
